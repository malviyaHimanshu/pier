{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "lib": ["ES2022", "DOM"],
    "types": ["node", "vitest/globals"],
    "allowJs": true
  },
  "include": [
    "**/*.js",
    "**/*.ts",
    "**/*.tsx",
    "../packages/**/*.ts",
    "../packages/**/*.tsx"
  ]
}
