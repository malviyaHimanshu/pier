{
  "name": "@malviyahimanshu/pier",
  "version": "1.0.5",
  "description": "Portless-powered in-browser terminals for localhost apps with per-host workspace routing",
  "packageManager": "pnpm@10.20.0",
  "bin": {
    "pier": "bin/pier.js"
  },
  "exports": {
    ".": "./server/pier-server.js",
    "./manifest.json": "./manifest.json"
  },
  "files": [
    "bin",
    "cli",
    "server",
    "packages/shared/dist",
    "packages/shared/package.json",
    "packages/cli-core/dist",
    "packages/cli-core/package.json",
    "packages/bridge-core/dist",
    "packages/bridge-core/package.json",
    "manifest.json",
    "README.md",
    "LICENSE",
    "!packages/*/dist/**/*.map"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "server/pier-server.js",
  "scripts": {
    "dev": "pnpm run build:packages && pnpm run build:manifest && pnpm run build:extension --watch",
    "build": "pnpm run build:packages && pnpm run build:icons && pnpm run build:extension && pnpm run build:manifest",
    "build:packages": "tsc -b packages/shared packages/cli-core packages/bridge-core",
    "build:extension": "node scripts/build-extension.js",
    "build:manifest": "node scripts/sync-manifest.js && pnpm exec prettier --write manifest.json",
    "build:icons": "node scripts/generate-icons.js",
    "pack:extension": "pnpm run build && node scripts/package-extension.js",
    "pack:npm": "npm pack --ignore-scripts",
    "server": "node server/pier-server.js",
    "dev-hosts": "node scripts/dev-hosts.js",
    "site:dev": "pnpm --filter @pier/site dev",
    "site:build": "pnpm --filter @pier/site build",
    "site:start": "pnpm --filter @pier/site start",
    "site:lint": "pnpm --filter @pier/site lint",
    "site:typecheck": "pnpm --filter @pier/site typecheck",
    "token": "node scripts/generate-token.js",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "pnpm run test:unit && pnpm run test:smoke",
    "test:unit": "pnpm run build:packages && vitest run",
    "test:smoke": "node scripts/smoke-check.js",
    "test:pack-smoke": "node scripts/pack-smoke.js",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run format:check && pnpm run test",
    "release:artifacts": "pnpm run build && pnpm run check && pnpm run pack:npm && pnpm run test:pack-smoke && node scripts/package-extension.js",
    "release:npm:dry-run": "pnpm run build && pnpm run check && npm publish --dry-run --access public",
    "prepack": "pnpm run build && pnpm run check"
  },
  "keywords": [
    "chrome-extension",
    "developer-tools",
    "terminal",
    "localhost",
    "portless",
    "xterm",
    "node-pty"
  ],
  "author": "Himanshu Malviya",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/malviyahimanshu/pier.git"
  },
  "homepage": "https://pier.himan.me",
  "bugs": {
    "url": "https://github.com/malviyahimanshu/pier/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "commonjs",
  "dependencies": {
    "node-pty": "^1.1.0",
    "portless": "~0.4.2",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/chrome": "^0.1.24",
    "@types/node": "^24.3.0",
    "@changesets/cli": "^2.29.7",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/preact": "^3.2.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "esbuild": "^0.25.1",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.1.1",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "preact": "^10.27.2",
    "prettier": "^3.5.2",
    "sharp": "^0.34.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vitest": "^3.2.4"
  }
}
